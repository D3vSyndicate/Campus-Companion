  "rules": [
    {
      "title": "Boarding requirement",
      "text": "To board the shuttle, all students must present a valid student ID card along with their proof of acceptance or registration letter."
    },
    {
      "title": "Early arrival",
      "text": "Students wishing to arrive early on campus are advised to take the first scheduled shuttle of the day."
    },
    {
      "title": "Assistance",
      "text": "Shuttle marshals are available to assist. Students who are unsure of the correct shuttle should ask a marshal for guidance."
    },
    {
      "title": "Code of conduct",
      "text": "Students are required to follow marshal and driver instructions at all times. Disrespectful behaviour or refusal to comply will result in immediate suspension of shuttle service privileges."
    },
    {
      "title": "Prohibited items and behaviour",
      "text": "No eating or drinking is permitted inside the shuttles. Alcohol is strictly prohibited. Any student deemed to be intoxicated will be denied access."
    }
  ],
